[Unit]
Description=Flumip Staging
After=network.target

[Service]
Type=simple
# The executable lives in bundle/bin/ because Serverpod 4 is built with
# `dart build cli`, which emits it alongside the native libraries in
# bundle/lib/ that it resolves relative to itself. WorkingDirectory stays the
# install root so config/, web/ and migrations/ still resolve.
WorkingDirectory=/var/www/flumip_staging
ExecStart=/var/www/flumip_staging/bundle/bin/main --mode=staging --server-id=staging --logging=verbose --role=monolith --apply-migrations
# Optional runtime configuration, chiefly the single sign-on settings; see
# docs/authentication.md. The leading dash is required, not cosmetic: the
# deploy workflows copy this unit onto hosts that have never run
# setup-flumip.sh, where this file does not exist. Without the dash systemd
# refuses to start the service and the next deploy of staging fails.
EnvironmentFile=-/etc/flumip/flumip_staging.env
Restart=always
User=www-data

[Install]
WantedBy=multi-user.target