# Per-package rules live in flumip_server/, flumip_flutter/ and flumip_client/.

# JetBrains project state is per developer, and dataSources.xml names real
# database hosts.
/.idea/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# A local Docker install run from inside the repository (docs/docker.md,
# "Building the image yourself"): its secrets and its data.
/deployment/docker/.env
/deployment/docker/data/
/deployment/docker/projects/
